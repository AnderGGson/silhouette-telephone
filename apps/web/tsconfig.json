{
  "extends": "@silhouette/tsconfig/nextjs",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@silhouette/*": [
        "../packages/*/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}

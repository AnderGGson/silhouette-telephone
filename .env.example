# URL del proyecto Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima/pública (segura para el navegador; las políticas RLS la protegen)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave de rol de servicio — SOLO en servidor (Route Handlers).
# Nunca exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de la app (usada para redirects de Auth y enlaces compartibles)
NEXT_PUBLIC_APP_URL=http://localhost:3000
